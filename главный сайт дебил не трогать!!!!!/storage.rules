rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Почта админа
    function isAdmin() { return request.auth != null && request.auth.token.email in ['nockisy@gmail.com', 'dilenowpc@gmail.com']; }
    function okFile() {
      return request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // публикации игроков: смотреть могут все, загружать/удалять — только владелец (и админ удаляет)
    match /media/{uid}/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && okFile();
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // вложения жалоб: читать и удалять могут ТОЛЬКО админы
    match /complaints/{uid}/{file} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && okFile();
    }
  }
}
